# ===================================================================
#  .gitignore del monorepo ELDE
#  Regla general: se versiona FUENTE y CONFIGURACION. Nunca pesos de
#  modelos, entornos virtuales, salidas de ejecucion ni empaquetados:
#  son regenerables y hunden el repositorio (solo "modelos NVIDIA"
#  ocupa 50 GB).
# ===================================================================

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ===== Entornos virtuales (cada proyecto tiene el suyo) =====
venv/
env/
.venv/

# ===== Secretos: NUNCA al repositorio =====
.env
*.key
*.pem

# ===== Modelos y pesos (50 GB; compartir por red o Git LFS) =====
modelos NVIDIA/
*.pt
*.pth
*.onnx
*.engine
*.bin
*.safetensors
models/
weights/
tmp_buffalo_l/
tmp_mivolo_v2/

# ===== SDK de terceros (Hikvision) =====
# ~200 MB de .exe/.dll/.pdb/.pdf y demos en C#/C++: son 3954 de los 4054
# archivos del arbol y NO son fuente de este proyecto. Se distribuyen
# aparte, igual que ya se hace con perimetrales-view/src/sdk/.
# Se conserva unicamente la nota propia de la API.
hik-connect/*
!hik-connect/api hik.txt

# ===== Empaquetados y distribucion =====
*.zip
dist/
build/

# ===== Salidas de ejecucion (se regeneran solas) =====
output/
runs/
screenshots/
capture/
snapshots/
_servidor_log.txt
_servidor_err.txt
_tienda_log.txt
_amazonas_log.txt
*.log

# ===== Material de pruebas pesado =====
vigilante_amazonas/pruebas/
vigilante_amazonas/logs/

# ===== IDE / SO =====
.vscode/
.idea/
.DS_Store
Thumbs.db
