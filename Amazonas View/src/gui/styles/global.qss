/* ═══════════════════════════════════════════════════════════════════
   AMAZONAS VIEW — Hoja de estilos global
   Tema oscuro de consola de analisis. La paleta vive en styles/tema.py;
   si cambias un color aqui, cambialo alli tambien.

     fondo      #0b0e14      texto        #e6e9ef
     superficie #131720      texto suave  #9aa4b8
     elevado    #1a1f2b      texto tenue  #5e6878
     borde      #232936      acento       #3d9dff
                             exito        #00d4aa
   ═══════════════════════════════════════════════════════════════════ */

QWidget {
    font-family: "Segoe UI Variable Display", "Segoe UI", system-ui, sans-serif;
    font-size: 12px;
    color: #e6e9ef;
}

QMainWindow, #MainWindowStyle {
    background-color: #0b0e14;
}

QLabel {
    color: #e6e9ef;
    background: transparent;
    border: none;
}

/* ── Pestañas ──────────────────────────────────────────────────────── */
QTabWidget::pane {
    background: #0b0e14;
    border: none;
    border-top: 1px solid #232936;
}

QTabBar::tab {
    background: transparent;
    color: #9aa4b8;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 18px;
    margin-right: 2px;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #e6e9ef;
    background: rgba(61, 157, 255, 0.06);
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #3d9dff;
}

#TabContent {
    background-color: #0b0e14;
}

/* ── Botones ───────────────────────────────────────────────────────── */
QPushButton {
    background-color: transparent;
    color: #9aa4b8;
    border: 1px solid #232936;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
}

QPushButton:hover {
    color: #e6e9ef;
    border-color: #3d9dff;
    background-color: rgba(61, 157, 255, 0.12);
}

QPushButton:pressed {
    background-color: rgba(61, 157, 255, 0.20);
}

QPushButton:disabled {
    color: #5e6878;
    border-color: #1b2029;
}

/* Botones de la barra flotante del visor: iconos compactos */
#btn-bar {
    min-width: 26px;  max-width: 26px;
    min-height: 26px; max-height: 26px;
    padding: 0;
    border: none;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.04);
}

#btn-bar:hover {
    background-color: rgba(61, 157, 255, 0.22);
}

#btn-bar:checked {
    background-color: rgba(0, 212, 170, 0.25);
}

/* ── Campos de texto y desplegables ────────────────────────────────── */
QLineEdit, QComboBox, QSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #0b0e14;
    color: #e6e9ef;
    border: 1px solid #232936;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #3d9dff;
    selection-color: #06101c;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border-color: #3d9dff;
}

QLineEdit:disabled, QComboBox:disabled {
    color: #5e6878;
    background-color: #131720;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #1a1f2b;
    color: #e6e9ef;
    border: 1px solid #232936;
    border-radius: 4px;
    selection-background-color: #3d9dff;
    selection-color: #06101c;
    outline: none;
}

/* ── Casillas ──────────────────────────────────────────────────────── */
QCheckBox {
    color: #e6e9ef;
    spacing: 8px;
    padding: 4px 6px;
    background: transparent;
}

QCheckBox::indicator {
    width: 15px; height: 15px;
    border-radius: 3px;
    border: 1px solid #232936;
    background: #0b0e14;
}

QCheckBox::indicator:hover   { border-color: #3d9dff; }
QCheckBox::indicator:checked { background: #3d9dff; border-color: #3d9dff; }

/* ── Menus ─────────────────────────────────────────────────────────── */
QMenu {
    background-color: #1a1f2b;
    border: 1px solid #232936;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    padding: 7px 14px;
    border-radius: 4px;
    color: #e6e9ef;
}

QMenu::item:selected {
    background-color: rgba(61, 157, 255, 0.18);
}

/* ── Barras de desplazamiento: finas y discretas ───────────────────── */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 9px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #232936;
    min-height: 26px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover { background: #35405a; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 9px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #232936;
    min-width: 26px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover { background: #35405a; }

QScrollBar::add-line, QScrollBar::sub-line {
    border: none; background: none; height: 0; width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ── Paneles laterales ─────────────────────────────────────────────── */
QWidget#SidebarDock, #ContentSidebar {
    background-color: #131720;
    border: none;
}

QWidget#Head {
    background: #131720;
    border-bottom: 1px solid #232936;
}

QDockWidget {
    background: #131720;
    border: none;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

/* ── Celda del visor de video ──────────────────────────────────────── */
#box-content {
    background-color: #0b0e14;
    border: 1px solid #1b2029;
    border-radius: 8px;
    padding: 0;
}

/* Realce discreto al pasar por encima: mismo grosor (no desplaza el
   contenido) y un azul apagado que no compite con la imagen. */
#box-content:hover {
    border: 1px solid #2b425e;
}

#bar_options, #bar_info {
    background-color: rgba(19, 23, 32, 0.94);
    border: none;
    padding: 0;
    margin: 0;
}

#text-fps {
    color: #00d4aa;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 10px;
    font-weight: 600;
}

/* ── Pie de ventana ────────────────────────────────────────────────── */
#FooterBar, QStatusBar {
    background-color: #131720;
    color: #9aa4b8;
    border-top: 1px solid #232936;
}

QStatusBar::item { border: none; }

/* ── Arbol de dispositivos ─────────────────────────────────────────── */
QTreeWidget, QTreeView, QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    color: #e6e9ef;
}

QTreeWidget::item, QListWidget::item {
    padding: 5px 4px;
    border-radius: 4px;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: rgba(61, 157, 255, 0.10);
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: rgba(61, 157, 255, 0.20);
    color: #ffffff;
}

/* ── Progreso ──────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #0b0e14;
    border: 1px solid #232936;
    border-radius: 4px;
    height: 5px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #3d9dff;
    border-radius: 3px;
}

/* ── Dialogos ──────────────────────────────────────────────────────── */
QDialog, QMessageBox {
    background-color: #131720;
    color: #e6e9ef;
}

QToolTip {
    background-color: #1a1f2b;
    color: #e6e9ef;
    border: 1px solid #232936;
    border-radius: 4px;
    padding: 5px 8px;
}

#title_semibold { font-weight: 600; }
